<Window x:Class="HaOir.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HaOir" Width="960" Height="600"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="Transparent">

    <Window.Resources>
        <!-- 背景渐变动画：Image1 和 Image2 交替渐变 -->
        <Storyboard x:Key="BackgroundAnimation" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="Image1" Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.0" Duration="0:0:5"/>
            <DoubleAnimation Storyboard.TargetName="Image2" Storyboard.TargetProperty="Opacity"
                             From="0.0" To="1.0" Duration="0:0:5"/>
        </Storyboard>

        <!-- 按钮圆角模板 -->
        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StartButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="10" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeToggleButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="15" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 层级 0：主窗口 Grid -->
    <Grid x:Name="RootGrid" MouseLeftButtonDown="RootGrid_MouseLeftButtonDown">
        
        <!-- 层级 1：MainBorder 卡片外壳 -->
        <Border x:Name="MainBorder" CornerRadius="16" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.8" Color="Black"/>
            </Border.Effect>

            <Grid>
                <!-- 层级 2：BackgroundGrid 背景层 -->
                <Grid x:Name="BackgroundGrid">
                    <Image x:Name="Image1" Source="Images/bg1.jpg" Stretch="UniformToFill" Opacity="1.0"/>
                    <Image x:Name="Image2" Source="Images/bg2.jpg" Stretch="UniformToFill" Opacity="0.0"/>
                </Grid>

                <!-- 层级 3：ForegroundGrid UI 控件层 -->
                <Grid x:Name="ForegroundGrid" ZIndex="1">
                    
                    <!-- 3.1 Logo 文字 -->
                    <TextBlock Text="HaOir" FontSize="24" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,25,0,0">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="0"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- 3.2 关闭按钮 -->
                    <Button x:Name="MainCloseBtn" Content="✕" Width="36" Height="36"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,20,0"
                            Background="#80000000" Foreground="White" Style="{StaticResource RoundButton}"
                            Click="MainCloseBtn_Click"/>

                    <!-- 3.3 开始游戏按钮 -->
                    <Button x:Name="StartGameBtn" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,30,30" Width="200" Height="50" Background="#FF8C00"
                            Style="{StaticResource StartButton}" Click="StartGameBtn_Click">
                        <Grid Width="180" Height="40">
                            <TextBlock Text="开始游戏" FontSize="16" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0"/>
                            <TextBlock Text="▼" Foreground="White"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        </Grid>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- 层级 4.1：下拉菜单 Popup -->
        <Popup x:Name="DropdownMenu" PlacementTarget="{Binding ElementName=StartGameBtn}" Placement="Bottom"
               Width="320" Height="380" StaysOpen="False">
            <Border Background="#E61E1E1E" CornerRadius="10" BorderThickness="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左列：分类列表 -->
                    <ListBox x:Name="CategoryList" Grid.Column="0" Background="Transparent" BorderThickness="0"
                             Foreground="White" SelectionChanged="CategoryList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Border" Background="Transparent" Padding="10,5"
                                                    CornerRadius="5" Margin="5,2">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#FF8C00"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#4DFF8C00"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBoxItem Content="原版"/>
                        <ListBoxItem Content="Forge"/>
                        <ListBoxItem Content="Fabric"/>
                        <ListBoxItem Content="NeoForge"/>
                        <ListBoxItem Content="服务端"/>
                    </ListBox>

                    <!-- 右列：版本列表 -->
                    <ListBox x:Name="VersionList" Grid.Column="1" Background="Transparent" BorderThickness="0"
                             Foreground="White" SelectionChanged="VersionList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Border" Background="Transparent" Padding="10,5"
                                                    CornerRadius="5" Margin="5,2">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#FF8C00"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#4DFF8C00"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>
        </Popup>

        <!-- 层级 4.2：账号弹窗遮罩 -->
        <Grid x:Name="ModalOverlay" Visibility="Collapsed" ZIndex="999"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#99000000">
            
            <!-- 层级 4.3：弹窗本体 -->
            <Border x:Name="DialogBorder" Width="460" Height="240" CornerRadius="15"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Background>
                    <SolidColorBrush Color="#1AFFFFFF"/>
                </Border.Background>
                <Border.Effect>
                    <BlurEffect Radius="0"/>
                </Border.Effect>

                <Grid>
                    <!-- 右上角控件组 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,15,15,0">
                        <Button x:Name="ModeToggleBtn" Content="正版" Width="80" Height="30"
                                Background="#4D000000" Foreground="White" Style="{StaticResource ModeToggleButton}"
                                Click="ModeToggleBtn_Click"/>
                        <Button x:Name="DialogCloseBtn" Content="✕" Width="30" Height="30"
                                Margin="10,0,0,0" Background="#4D000000" Foreground="White"
                                Style="{StaticResource RoundButton}" Click="DialogCloseBtn_Click"/>
                    </StackPanel>

                    <!-- 弹窗主体内容 -->
                    <Grid Margin="25,70,25,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：输入区域 -->
                        <Grid Grid.Column="0" Margin="0,0,15,0">
                            <!-- 离线模式：输入框 -->
                            <TextBox x:Name="InputNameBox" Height="40" VerticalAlignment="Center"
                                     FontSize="14" Padding="10,0" Visibility="Visible">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="#4DFFFFFF"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="CaretBrush" Value="White"/>
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <VisualBrush>
                                                            <VisualBrush.Visual>
                                                                <TextBlock Text="输入你的名字" Foreground="#99FFFFFF"
                                                                           FontSize="14" Padding="10,0"/>
                                                            </VisualBrush.Visual>
                                                        </VisualBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <!-- 正版模式：提示文字 -->
                            <TextBlock x:Name="PremiumText" Text="点击确定后将打开微软官方登录页"
                                       Foreground="White" FontSize="14" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>

                        <!-- 右侧：确定按钮 -->
                        <Button x:Name="ConfirmBtn" Content="确定" Width="90" Height="40"
                                Grid.Column="1" Background="#FF8C00" Foreground="White"
                                Style="{StaticResource RoundButton}" VerticalAlignment="Center"
                                Click="ConfirmBtn_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
